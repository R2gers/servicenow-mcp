# ServiceNow Instance Configuration
# Copy this file to .env in your project folder and fill in your values.
# NEVER commit the .env file — it contains credentials.

SERVICENOW_INSTANCE_URL=https://yourinstance.service-now.com
SERVICENOW_AUTH_TYPE=basic
SERVICENOW_USERNAME=your_username
SERVICENOW_PASSWORD=your_password

# ── Optional: OAuth Authentication ──────────────────────────────────────────
# Set SERVICENOW_AUTH_TYPE=oauth and fill in the fields below.
#
# SERVICENOW_AUTH_TYPE=oauth
# SERVICENOW_CLIENT_ID=your_client_id
# SERVICENOW_CLIENT_SECRET=your_client_secret
# SERVICENOW_TOKEN_URL=https://yourinstance.service-now.com/oauth_token.do

# ── Optional: request timeout in seconds (default 30) ───────────────────────
# SERVICENOW_TIMEOUT=30

# ── Optional: force read-only for this project ──────────────────────────────
# Write access is otherwise decided by the instance policy (see README).
# This setting can only tighten it.
# SERVICENOW_READ_ONLY=true

# ── Optional: scope / update set check ──────────────────────────────────────
# On by default: configuration writes are refused when they would land in a
# Default update set or in another application. Set to off to disable.
# SERVICENOW_UPDATE_SET_CHECK=on
